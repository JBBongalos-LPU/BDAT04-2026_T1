					  #"Inserted day" = Table.AddColumn(#"Inserted month name", "Day", each Date.Day([Date]), type nullable number),
					  #"Inserted day name" = Table.AddColumn(#"Inserted day", "Day name", each Date.DayOfWeekName([Date]), type nullable text)
					in
					    #"Inserted day name"

