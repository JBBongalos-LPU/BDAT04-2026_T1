		partition dimDate = m
			mode: import
			source =
					let
					    Start = #date(2025, 1, 1),
					    Finish = #date(2026, 12, 31),
					    Days = Duration.Days(Finish - Start) + 1,
					    Dates = List.Dates(Start, Days, #duration(1, 0, 0, 0)),
					    Source = Table.FromList(Dates, Splitter.SplitByNothing(), {"Date"}),
					    Typed = Table.TransformColumnTypes(Source, {{"Date", type date}}),
					  #"Inserted year" = Table.AddColumn(Typed, "Year", each Date.Year([Date]), type nullable number),
